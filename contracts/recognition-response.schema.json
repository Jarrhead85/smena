{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nurseshift/recognition-response.schema.json",
  "title": "NurseShift recognition response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assignments", "unparsed_lines"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "assignments": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patient_name",
          "room",
          "bed",
          "time",
          "procedure",
          "dosage",
          "comment",
          "source_excerpt",
          "needs_review",
          "review_reason"
        ],
        "properties": {
          "patient_name": { "type": ["string", "null"], "maxLength": 200 },
          "room": { "type": ["string", "null"], "maxLength": 30 },
          "bed": { "type": ["string", "null"], "maxLength": 30 },
          "time": {
            "type": ["string", "null"],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "procedure": { "type": ["string", "null"], "maxLength": 500 },
          "dosage": { "type": ["string", "null"], "maxLength": 500 },
          "comment": { "type": ["string", "null"], "maxLength": 2000 },
          "source_excerpt": { "type": ["string", "null"], "maxLength": 2000 },
          "needs_review": { "type": "boolean" },
          "review_reason": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    },
    "unparsed_lines": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reason"],
        "properties": {
          "text": { "type": ["string", "null"], "maxLength": 2000 },
          "reason": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
