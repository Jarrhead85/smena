<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark=#111614}" /></Style>
  <Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryColor}, Dark=#F0F4F2}" /><Setter Property="FontSize" Value="17" /><Setter Property="LineBreakMode" Value="WordWrap" /></Style>
  <Style x:Key="ScreenTitle" TargetType="Label"><Setter Property="FontSize" Value="28" /><Setter Property="FontAttributes" Value="Bold" /></Style>
  <Style x:Key="SectionTitle" TargetType="Label"><Setter Property="FontSize" Value="20" /><Setter Property="FontAttributes" Value="Bold" /></Style>
  <Style x:Key="SecondaryText" TargetType="Label"><Setter Property="FontSize" Value="15" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark=#B8C6C0}" /></Style>
  <Style x:Key="CaptionText" TargetType="Label"><Setter Property="FontSize" Value="13" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark=#B8C6C0}" /></Style>
  <Style x:Key="ScheduleTime" TargetType="Label"><Setter Property="FontSize" Value="24" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="LineBreakMode" Value="NoWrap" /><Setter Property="Margin" Value="0,0,12,0" /></Style>
  <Style x:Key="BaseButton" TargetType="Button"><Setter Property="FontSize" Value="17" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="MinimumWidthRequest" Value="48" /><Setter Property="Padding" Value="16,12" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark=#8BD1C3}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryColor}, Dark=#0B312B}" /></Style>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark=#1A211E}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark=#8BD1C3}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineColor}, Dark=#50615A}" /><Setter Property="BorderWidth" Value="1" /></Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorColor}, Dark=#F0A3A3}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ErrorColor}, Dark=#F0A3A3}" /><Setter Property="BorderWidth" Value="1" /></Style>
  <Style TargetType="Entry"><Setter Property="FontSize" Value="17" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryColor}, Dark=#F0F4F2}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark=#1A211E}" /></Style>
  <Style TargetType="Editor"><Setter Property="FontSize" Value="17" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryColor}, Dark=#F0F4F2}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark=#1A211E}" /></Style>
  <Style TargetType="DatePicker"><Setter Property="FontSize" Value="17" /><Setter Property="MinimumHeightRequest" Value="52" /></Style>
  <Style TargetType="TimePicker"><Setter Property="FontSize" Value="17" /><Setter Property="MinimumHeightRequest" Value="52" /></Style>
  <Style TargetType="Switch"><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="48" /></Style>
  <Style TargetType="BoxView"><Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineColor}, Dark=#50615A}" /><Setter Property="HeightRequest" Value="1" /></Style>
</ResourceDictionary>
