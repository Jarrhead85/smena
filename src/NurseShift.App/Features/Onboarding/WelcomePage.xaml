<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:res="clr-namespace:NurseShift.App.Resources.Strings" x:Class="NurseShift.App.Features.Onboarding.WelcomePage">
  <ScrollView><VerticalStackLayout Padding="24" Spacing="24" VerticalOptions="Center">
    <Label Text="{x:Static res:UiStrings.AppName}" Style="{StaticResource ScreenTitle}" />
    <Label Text="{x:Static res:UiStrings.WelcomeText}" FontAttributes="Bold" />
    <Label Text="{x:Static res:UiStrings.WelcomeFacts}" />
    <Button Text="{x:Static res:UiStrings.Start}" Command="{Binding StartCommand}" />
    <Button Text="{x:Static res:UiStrings.TestShift}" Command="{Binding TestShiftCommand}" Style="{StaticResource SecondaryButton}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
