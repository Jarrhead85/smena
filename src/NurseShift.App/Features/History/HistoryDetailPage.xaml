<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:res="clr-namespace:NurseShift.App.Resources.Strings" xmlns:core="clr-namespace:NurseShift.Core.Models;assembly=NurseShift.Core" x:Class="NurseShift.App.Features.History.HistoryDetailPage" Title="{x:Static res:UiStrings.CompletedShift}">
  <Grid RowDefinitions="*,Auto"><CollectionView ItemsSource="{Binding Assignments}"><CollectionView.Header><VerticalStackLayout Padding="16" Spacing="8"><Label Text="{x:Static res:UiStrings.CompletedShift}" Style="{StaticResource ScreenTitle}" /><Label Text="{Binding Dates}" /><Label Text="{Binding Stats}" Style="{StaticResource SecondaryText}" /></VerticalStackLayout></CollectionView.Header>
    <CollectionView.ItemTemplate><DataTemplate x:DataType="core:Assignment"><Grid ColumnDefinitions="Auto,*" Padding="16,10"><Label Text="{Binding DueLocal, StringFormat='{}{0:HH:mm}'}" Style="{StaticResource ScheduleTime}" /><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Procedure}" FontAttributes="Bold" /><Label Text="{Binding PatientName}" /><Label Text="{Binding Room}" Style="{StaticResource SecondaryText}" /><Label Text="{Binding Dosage}" /><Label Text="{Binding Comment}" /><Label Text="{Binding ExecutionStatus}" /></VerticalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="8"><Label Text="{Binding ErrorMessage}" /><Button Text="{x:Static res:UiStrings.Reactivate}" Command="{Binding ReactivateCommand}" /><Button Text="{x:Static res:UiStrings.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" /></VerticalStackLayout>
  </Grid>
</ContentPage>
